{
  "name": "boermens-gevecht",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Achterhoek tegen de havermelkelite: een lane-battle voor twee spelers op één toetsenbord.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "node scripts/balance.ts",
    "shots": "node scripts/shot.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@xmldom/xmldom": "0.9.12",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
